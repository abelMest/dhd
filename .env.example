# Copy to .env and fill in. Without these the site builds from data/seed.json and the console stays off.

# Public: safe in the browser. Row-level security decides what each person can do.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Private: only for the import scripts on your own computer and in GitHub Actions secrets.
# Never add it to Cloudflare Pages or commit it.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The site's address (used for canonical links, sitemap and share images).
SITE_URL=https://dhdigest.org
