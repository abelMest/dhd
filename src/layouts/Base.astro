---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { loadSite } from '../lib/data';
import { TOPICS, topicSlug } from '../lib/taxonomy';
// Preloading the two Latin font files stops the text reflowing when they arrive.
import serifUrl from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import sansUrl from '@fontsource-variable/league-spartan/files/league-spartan-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  /** Show the reading-progress line under the masthead (edition pages). */
  progress?: boolean;
}
const { title, description, image, type = 'website', noindex = false, jsonLd, progress = false } = Astro.props;
const site = await loadSite();
const { copy, settings } = site;

const SITE_NAME = 'Digital Health Digest';
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME}: ideas, resources and opportunities in digital health`;
const desc = description || copy.lede;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image || '/og/default.png', Astro.site).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/editions/', label: 'Editions' },
  { href: '/library/', label: 'Library' },
  { href: '/opportunities/', label: 'Opportunities' },
  { href: '/contribute/', label: 'Contribute' },
  { href: '/about/', label: 'About' },
];
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
const year = new Date().getUTCFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title || SITE_NAME} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07131d" media="(prefers-color-scheme: dark)" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Theme, and whether motion is welcome: never for reduced-motion users, data-saver or 2G connections.
      // .motion hides reveal targets until motion.ts shows them; if it has not started in 4 s, show everything.
      (function () {
        var r = document.documentElement;
        try { var t = localStorage.getItem('dhd-theme'); if (t) r.dataset.theme = t; } catch (e) {}
        var c = navigator.connection || {};
        var calm = matchMedia('(prefers-reduced-motion: reduce)').matches || c.saveData || /2g/.test(c.effectiveType || '');
        if (!calm) { r.classList.add('motion'); setTimeout(function () { if (!r.classList.contains('motion-on')) r.classList.remove('motion'); }, 4000); }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {copy.announce && (
      <div class="announce">
        {copy.announceUrl ? <a href={copy.announceUrl}>{copy.announce}</a> : copy.announce}
      </div>
    )}
    <header class="masthead">
      <div class="wrap">
        <a class="logo" href="/" aria-label="Digital Health Digest, home"><Logo animate /></a>
        <nav class="nav" id="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={current(n.href)}>{n.label}</a>)}
        </nav>
        <div class="headActions">
          <a class="iconBtn" href="/search/" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </a>
          <button class="iconBtn themeIcon" id="themeBtn" type="button" aria-label="Switch light or dark theme">
            <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <a class="btn sm" href={settings.substackUrl} rel="noopener">Subscribe <span class="arrow" aria-hidden="true">→</span></a>
          <button class="menuPill" id="menuBtn" type="button" aria-expanded="false" aria-controls="fsMenu">Menu <span class="dots" aria-hidden="true"><i></i><i></i></span></button>
        </div>
      </div>
      {progress && <div class="progress-ecg" aria-hidden="true"><span data-progress></span></div>}
    </header>

    <div class="fsMenu" id="fsMenu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
      <div class="fsTop">
        <a class="logo" href="/" aria-label="Digital Health Digest, home"><Logo /></a>
        <button class="fsClose" type="button" id="fsClose" aria-label="Close the menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </div>
      <nav aria-label="Main">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}><small>00</small>Home</a>
        {nav.map((n, i) => <a href={n.href} aria-current={current(n.href)}><small>{String(i + 1).padStart(2, '0')}</small>{n.label}</a>)}
      </nav>
      <div class="fsFoot">
        <a class="btn" href={settings.substackUrl} rel="noopener" style="justify-self:start">Subscribe free <span class="arrow" aria-hidden="true">→</span></a>
        <span><a href="/search/">Search the archive</a> · <a href={settings.substackUrl} rel="noopener">Substack</a>{settings.linkedinUrl && <> · <a href={settings.linkedinUrl} rel="noopener">LinkedIn</a></>}</span>
      </div>
    </div>

    <main id="main"><slot /></main>

    <button class="toTop" id="toTop" type="button" aria-label="Back to top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </button>

    <footer class="footer">
      <svg class="bigBeat" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 80 H430 L450 80 L462 60 L478 104 L496 8 L514 112 L530 80 L548 80 Q566 52 584 80 H1200" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" pathLength="1" data-draw />
      </svg>
      <div class="wrap">
        <div class="cols">
          <div>
            <a class="logo" href="/" aria-label="Digital Health Digest, home"><Logo /></a>
            <p style="margin-top:18px;max-width:40ch">{copy.footerAbout}</p>
          </div>
          <div>
            <h2 class="footHead">Read</h2>
            <ul>
              <li><a href="/editions/">All editions</a></li>
              {TOPICS.slice(0, 4).map((t) => <li><a href={`/topics/${topicSlug(t)}/`}>{t}</a></li>)}
            </ul>
          </div>
          <div>
            <h2 class="footHead">Use</h2>
            <ul>
              <li><a href="/library/">Library</a></li>
              <li><a href="/opportunities/">Opportunities</a></li>
              <li><a href="/contribute/">Write for the Digest</a></li>
              <li><a href="/about/">About and standards</a></li>
            </ul>
          </div>
          <div>
            <h2 class="footHead">Follow</h2>
            <ul>
              <li><a href={settings.substackUrl} rel="noopener">Substack</a></li>
              {settings.linkedinUrl && <li><a href={settings.linkedinUrl} rel="noopener">LinkedIn newsletter</a></li>}
              <li><a href="/rss.xml">RSS feed</a></li>
            </ul>
          </div>
        </div>
        <div class="base">
          <span>© {year} Digital Health Digest</span>
          <a href="/console/">Editor sign-in</a>
        </div>
      </div>
    </footer>

    <script>
      // Motion is a separate download, fetched only when it's welcome (see the inline script in <head>).
      if (document.documentElement.classList.contains('motion')) {
        const go = () => import('../scripts/motion');
        if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 1500 }); else setTimeout(go, 200);
      }

      const head = document.querySelector('.masthead');
      const toTop = document.getElementById('toTop');
      const onScroll = () => { head?.classList.toggle('scrolled', scrollY > 8); toTop?.classList.toggle('show', scrollY > innerHeight * 1.2); };
      toTop?.addEventListener('click', () => scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }));
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Reading progress for browsers without CSS scroll-driven animations.
      const bar = document.querySelector<HTMLElement>('[data-progress]');
      if (bar && !CSS.supports('animation-timeline: scroll()')) {
        const upd = () => { const h = document.documentElement.scrollHeight - innerHeight; bar.style.transform = `scaleX(${h > 0 ? scrollY / h : 0})`; };
        addEventListener('scroll', upd, { passive: true }); upd();
      }

      // Full-screen menu (phones): opens as a circle from the Menu pill; Escape or the close button shut it.
      const menu = document.getElementById('menuBtn');
      const sheet = document.getElementById('fsMenu');
      const setMenu = (open: boolean) => {
        if (!sheet || !menu) return;
        if (open) sheet.hidden = false;
        requestAnimationFrame(() => sheet.classList.toggle('open', open));
        document.documentElement.classList.toggle('menu-open', open);
        menu.setAttribute('aria-expanded', String(open));
        if (open) setTimeout(() => { if (sheet.classList.contains('open')) sheet.querySelector<HTMLElement>('nav a')?.focus(); }, 250);
        else { menu.focus(); setTimeout(() => { if (!sheet.classList.contains('open')) sheet.hidden = true; }, 650); }
      };
      menu?.addEventListener('click', () => setMenu(true));
      document.getElementById('fsClose')?.addEventListener('click', () => setMenu(false));
      addEventListener('keydown', (e) => { if (e.key === 'Escape' && sheet?.classList.contains('open')) setMenu(false); });
      // Keep keyboard focus inside the open menu.
      sheet?.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab') return;
        const items = [...sheet.querySelectorAll<HTMLElement>('a, button')];
        const first = items[0], last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      });
      document.getElementById('themeBtn')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('dhd-theme', root.dataset.theme); } catch (e) {}
      });
    </script>
  </body>
</html>
