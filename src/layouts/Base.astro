---
import '../styles/global.css';
// Cinematic layer: loaded after global.css so its rules win where they refine global ones (buttons, header).
import '../styles/cinema.css';
import Logo from '../components/Logo.astro';
import T from '../components/T.astro';
import { NAV_FR, topicFr } from '../lib/i18n';
import { loadSite, clip } from '../lib/data';
import { TOPICS, topicSlug } from '../lib/taxonomy';
// Preloading the two Latin font files stops the text reflowing when they arrive.
import serifUrl from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import sansUrl from '@fontsource-variable/league-spartan/files/league-spartan-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  /** Replaces the whole <title> (editions with a search-title override). */
  searchTitle?: string;
  /** Trail from the home page to this page, for breadcrumb structured data. The current page goes last. */
  breadcrumbs?: { name: string; href: string }[];
  /** Show the reading-progress line under the masthead (edition pages). */
  progress?: boolean;
}
const { title, description, image, type = 'website', noindex = false, jsonLd, progress = false, searchTitle, breadcrumbs } = Astro.props;
const site = await loadSite();
const { copy, settings } = site;

const SITE_NAME = 'Digital Health Digest';
// Google shows about 60 characters of a title: keep the site name only when it fits.
const withName = title ? `${title} | ${SITE_NAME}` : '';
const fullTitle = searchTitle?.trim() || (!title ? `${SITE_NAME}: ideas and evidence in digital health` : withName.length <= 62 ? withName : title);
const desc = clip(description || copy.lede);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image || '/og/default.jpg', Astro.site).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/start/', label: 'Start here' },
  { href: '/editions/', label: 'Editions' },
  { href: '/library/', label: 'Library' },
  { href: '/opportunities/', label: 'Opportunities' },
  { href: '/contribute/', label: 'Contribute' },
  { href: '/about/', label: 'About' },
];
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
const CHAPTERS: Record<string, { href: string; label: string }> = {
  '/': { href: '/editions/', label: 'Editions' },
  '/editions/': { href: '/library/', label: 'Library' },
  '/library/': { href: '/opportunities/', label: 'Opportunities' },
  '/opportunities/': { href: '/contribute/', label: 'Contribute' },
  '/contribute/': { href: '/about/', label: 'About' },
  '/about/': { href: '/', label: 'Home' },
};
const next = CHAPTERS[path] || (path.startsWith('/topics/') || path.startsWith('/authors/') ? CHAPTERS['/'] : null);
const year = new Date().getUTCFullYear();
// Who publishes the site, and how to search it (home page only).
const siteUrl = new URL('/', Astro.site).href;
const siteLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization', '@id': `${siteUrl}#org`, name: SITE_NAME, url: siteUrl,
      logo: new URL('/brand/logo-original.webp', Astro.site).href,
      sameAs: [settings.substackUrl, settings.linkedinUrl].filter(Boolean),
    },
    {
      '@type': 'WebSite', '@id': `${siteUrl}#site`, name: SITE_NAME, url: siteUrl, inLanguage: 'en', publisher: { '@id': `${siteUrl}#org` },
      potentialAction: { '@type': 'SearchAction', target: `${siteUrl}search/?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {settings.revenue.adsense.client && <meta name="google-adsense-account" content={settings.revenue.adsense.client} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title || SITE_NAME} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07131d" media="(prefers-color-scheme: dark)" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {path === '/' && <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />}
    {breadcrumbs?.length && <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.href, Astro.site).href })),
    })} />}
    <script is:inline>
      // Theme, and whether motion is welcome: never for reduced-motion users, data-saver or 2G connections.
      // .motion hides reveal targets until motion.ts shows them; if it has not started in 4 s, show everything.
      (function () {
        var r = document.documentElement;
        try { var t = localStorage.getItem('dhd-theme'); if (t) r.dataset.theme = t; } catch (e) {}
        try { if (localStorage.getItem('dhd-lang') === 'fr') r.classList.add('fr'); } catch (e) {}
        var c = navigator.connection || {};
        var calm = matchMedia('(prefers-reduced-motion: reduce)').matches || c.saveData || /2g/.test(c.effectiveType || '');
        if (!calm) { r.classList.add('motion'); setTimeout(function () { if (!r.classList.contains('motion-on')) r.classList.remove('motion'); }, 4000); }
        // The title card plays once per visit, never for calm settings.
        try { if (!calm && !sessionStorage.getItem('dhd-seen')) { r.classList.add('preloading'); sessionStorage.setItem('dhd-seen', '1'); } } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <div class="preloader" id="preloader" aria-hidden="true" hidden>
      <div class="plLogo"><Logo height={120} /></div>
      <div class="plRing"><svg viewBox="0 0 64 64"><circle class="t" cx="32" cy="32" r="28" /><circle class="v" cx="32" cy="32" r="28" /></svg><span id="plNum">0%</span></div>
      <div class="plBar"></div>
    </div>
    <script is:inline>
      (function () {
        var r = document.documentElement, pl = document.getElementById('preloader');
        if (!r.classList.contains('preloading') || !pl) return;
        pl.hidden = false;
        var n = document.getElementById('plNum'), t0 = performance.now();
        (function tick(t) { var p = Math.min(1, (t - t0) / 1300); n.textContent = Math.round(100 * (1 - Math.pow(1 - p, 2))) + '%'; if (p < 1) requestAnimationFrame(tick); })(t0);
        setTimeout(function () { pl.classList.add('done'); r.classList.remove('preloading'); }, 1400);
        setTimeout(function () { pl.remove(); }, 2200);
      })();
    </script>
    <a class="skip" href="#main"><T en="Skip to content" fr="Aller au contenu" /></a>
    {copy.announce && (
      <div class="announce">
        {copy.announceUrl ? <a href={copy.announceUrl}>{copy.announce}</a> : copy.announce}
      </div>
    )}
    <header class="masthead">
      <div class="wrap">
        <a class="logo" href="/" aria-label="Digital Health Digest, home"><Logo animate /></a>
        <nav class="nav" id="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={current(n.href)}><T en={n.label} fr={NAV_FR[n.href] || n.label} /></a>)}
        </nav>
        <div class="headActions">
          <a class="iconBtn" href="/search/" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </a>
          <button class="langBtn" type="button" data-lang-toggle aria-label="Lire en français / Read in English" title="Français / English"><span class="l-en">FR</span><span class="l-fr">EN</span></button>
          <button class="iconBtn themeIcon" id="themeBtn" type="button" aria-label="Switch light or dark theme">
            <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <a class="btn sm" href={settings.substackUrl} rel="noopener"><T en="Subscribe" fr="S’abonner" /> <span class="arrow" aria-hidden="true">→</span></a>
          <button class="menuPill" id="menuBtn" type="button" aria-expanded="false" aria-controls="fsMenu"><span class="openTxt">Menu</span><span class="closeTxt"><T en="Close" fr="Fermer" /></span> <span class="dots" aria-hidden="true"><i></i><i></i></span></button>
        </div>
      </div>
      {progress && <div class="progress-ecg" aria-hidden="true"><span data-progress></span></div>}
    </header>

    <div class="fsMenu" id="fsMenu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
      <div class="menuCard">
        <nav aria-label="Main">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}><small>00</small><span class="mk"><T en="Home" fr="Accueil" /></span></a>
          {nav.map((n, i) => <a href={n.href} aria-current={current(n.href)}><small>{String(i + 1).padStart(2, '0')}</small><span class="mk"><T en={n.label} fr={NAV_FR[n.href] || n.label} /></span></a>)}
        </nav>
        <div class="fsFoot">
          <a class="btn" href={settings.substackUrl} rel="noopener" style="justify-self:start"><T en="Subscribe free" fr="S’abonner gratuitement" /> <span class="arrow" aria-hidden="true">→</span></a>
          <button class="langBtn wide" type="button" data-lang-toggle style="justify-self:start"><span class="l-en">Lire en français</span><span class="l-fr">Read in English</span></button>
          <span><a href="/search/"><T en="Search the archive" fr="Chercher dans les archives" /></a> · <a href={settings.substackUrl} rel="noopener">Substack</a>{settings.linkedinUrl && <> · <a href={settings.linkedinUrl} rel="noopener">LinkedIn</a></>}</span>
        </div>
      </div>
    </div>

    <main id="main">
      <slot />
      {next && (
        <div class="wrap">
          <a class="nextChapter" href={next.href} data-cursor="Go">
            <span class="k"><span class="pulse-dot" aria-hidden="true"></span><T en="Next chapter" fr="Chapitre suivant" /></span>
            <span class="t"><span class="name"><T en={next.label} fr={NAV_FR[next.href] || next.label} /></span><span class="go" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></span>
          </a>
        </div>
      )}
    </main>
    <div class="cursor" aria-hidden="true"><span></span></div>

    <button class="toTop" id="toTop" type="button" aria-label="Back to top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </button>

    <footer class="footer">
      <div class="wrap">
        <div class="cols" data-footer-cols>
          <div>
            <a class="logo" href="/" aria-label="Digital Health Digest, home"><Logo /></a>
            <p style="margin-top:18px;max-width:40ch">{copy.footerAbout}</p>
          </div>
          <div>
            <h2 class="footHead"><T en="Read" fr="Lire" /></h2>
            <ul>
              <li><a href="/start/"><T en="Start here: getting into digital health" fr="Commencer ici : se lancer dans la santé numérique" /></a></li>
              <li><a href="/editions/"><T en="All editions" fr="Toutes les éditions" /></a></li>
              {TOPICS.slice(0, 4).map((t) => <li><a href={`/topics/${topicSlug(t)}/`}><T en={t} fr={topicFr(t)} /></a></li>)}
            </ul>
          </div>
          <div>
            <h2 class="footHead"><T en="Use" fr="Utiliser" /></h2>
            <ul>
              <li><a href="/library/"><T en="Library" fr="Bibliothèque" /></a></li>
              <li><a href="/opportunities/"><T en="Opportunities" fr="Opportunités" /></a></li>
              <li><a href="/contribute/"><T en="Write for the Digest" fr="Écrire pour le Digest" /></a></li>
              <li><a href="/about/"><T en="About and standards" fr="À propos et principes éditoriaux" /></a></li>
              <li><a href="/partner/"><T en="Partner with us" fr="Devenir partenaire" /></a></li>
            </ul>
          </div>
          <div>
            <h2 class="footHead"><T en="Follow" fr="Suivre" /></h2>
            <ul>
              <li><a href={settings.substackUrl} rel="noopener">Substack</a></li>
              {settings.linkedinUrl && <li><a href={settings.linkedinUrl} rel="noopener"><T en="LinkedIn newsletter" fr="Newsletter LinkedIn" /></a></li>}
              <li><a href="/rss.xml"><T en="RSS feed" fr="Flux RSS" /></a></li>
              {settings.revenue.supportUrl && <li><a href={settings.revenue.supportUrl} rel="noopener"><b><T en="Support the Digest" fr="Soutenir le Digest" /></b></a></li>}
            </ul>
          </div>
        </div>
        <div class="base">
          <span>© {year} Digital Health Digest</span>
          <span><a href="/privacy/"><T en="Privacy" fr="Confidentialité" /></a> · <a href="/console/"><T en="Editor sign-in" fr="Connexion éditeur" /></a></span>
        </div>
        <a class="giantLogo" href="/" aria-label="Digital Health Digest, home"><Logo height={260} /></a>
      </div>
    </footer>

    <script>
      // Motion is a separate download, fetched only when it's welcome (see the inline script in <head>).
      if (document.documentElement.classList.contains('motion')) {
        const go = () => import('../scripts/motion');
        if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 1500 }); else setTimeout(go, 200);
      }

      const head = document.querySelector('.masthead');
      const toTop = document.getElementById('toTop');
      let lastY = scrollY;
      const onScroll = () => {
        const y = scrollY;
        head?.classList.toggle('scrolled', y > 8);
        // Hide on the way down (past the first screen), show again on the way up.
        if (Math.abs(y - lastY) > 6) { head?.classList.toggle('hide', y > lastY && y > innerHeight * 0.6); lastY = y; }
        toTop?.classList.toggle('show', y > innerHeight * 1.2);
      };
      // Over dark chapters the header and the back-to-top button switch to their light versions.
      const darks = document.querySelectorAll('.navy, .pinStory, .board, .footer, .tipPanel.wide');
      const watch = (el: Element | null, band: string, cls: string) => {
        if (!el || !darks.length) return;
        const on = new Set<Element>();
        const io = new IntersectionObserver((es) => { es.forEach((e) => (e.isIntersecting ? on.add(e.target) : on.delete(e.target))); el.classList.toggle(cls, on.size > 0); }, { rootMargin: band });
        darks.forEach((d) => io.observe(d));
      };
      watch(head, '0px 0px -92% 0px', 'onDark');
      watch(toTop, '-90% 0px 0px 0px', 'onDark');
      toTop?.addEventListener('click', () => {
        const lenis = (window as unknown as { dhdLenis?: { scrollTo: (y: number, o: object) => void } }).dhdLenis;
        if (lenis) lenis.scrollTo(0, { duration: 1.4 });
        else scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Reading progress for browsers without CSS scroll-driven animations.
      const bar = document.querySelector<HTMLElement>('[data-progress]');
      if (bar && !CSS.supports('animation-timeline: scroll()')) {
        const upd = () => { const h = document.documentElement.scrollHeight - innerHeight; bar.style.transform = `scaleX(${h > 0 ? scrollY / h : 0})`; };
        addEventListener('scroll', upd, { passive: true }); upd();
      }

      // Full-screen menu (phones): opens as a circle from the Menu pill; Escape or the close button shut it.
      const menu = document.getElementById('menuBtn');
      const sheet = document.getElementById('fsMenu');
      const setMenu = (open: boolean) => {
        if (!sheet || !menu) return;
        if (open) sheet.hidden = false;
        requestAnimationFrame(() => sheet.classList.toggle('open', open));
        document.documentElement.classList.toggle('menu-open', open);
        menu.setAttribute('aria-expanded', String(open));
        dispatchEvent(new CustomEvent('dhd:menu', { detail: open }));
        if (open) setTimeout(() => { if (sheet.classList.contains('open')) sheet.querySelector<HTMLElement>('nav a')?.focus(); }, 250);
        else { menu.focus(); setTimeout(() => { if (!sheet.classList.contains('open')) sheet.hidden = true; }, 500); }
      };
      menu?.addEventListener('click', () => setMenu(menu.getAttribute('aria-expanded') !== 'true'));
      sheet?.addEventListener('click', (e) => { if (e.target === sheet) setMenu(false); });
      addEventListener('keydown', (e) => { if (e.key === 'Escape' && sheet?.classList.contains('open')) setMenu(false); });
      // Keep keyboard focus inside the open menu.
      const trap = (e: KeyboardEvent) => {
        if (!sheet?.classList.contains('open')) return;
        if (e.key !== 'Tab') return;
        const items = [menu!, ...sheet.querySelectorAll<HTMLElement>('a, button')];
        const first = items[0], last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      };
      sheet?.addEventListener('keydown', trap);
      menu?.addEventListener('keydown', trap);
      document.getElementById('themeBtn')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('dhd-theme', root.dataset.theme); } catch (e) {}
      });
    </script>
      <script is:inline>
      // English / French: remembered, applied before paint by the head script. French mode shows each
      // edition's "En bref" summary and the interface in French; editions themselves are in English.
      document.querySelectorAll('[data-lang-toggle]').forEach(function (b) {
        b.addEventListener('click', function () {
          var on = document.documentElement.classList.toggle('fr');
          try { localStorage.setItem('dhd-lang', on ? 'fr' : 'en'); } catch (e) {}
          document.querySelectorAll('[data-lang-toggle]').forEach(function (x) { x.setAttribute('aria-pressed', String(on)); });
        });
        b.setAttribute('aria-pressed', String(document.documentElement.classList.contains('fr')));
      });
    </script>
  </body>
</html>
