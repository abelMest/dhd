---
import Base from '../layouts/Base.astro';
import Console from '../islands/console/Console';
---
<Base title="Editor console" noindex>
  <section class="section" style="padding-top:40px">
    <div class="wrap">
      <p class="kicker">Editor console</p>
      <Console client:only="preact" />
      <noscript><p class="notice">The console needs JavaScript.</p></noscript>
    </div>
  </section>
</Base>

<style is:global>
  .consoleBar { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; padding-bottom: 20px; margin-bottom: 28px; border-bottom: 1px solid var(--line); }
  .publish { display: grid; gap: 6px; justify-items: end; text-align: right; max-width: 320px; }
  /* Drafts waiting: a gentle nudge under Publish site, with each draft one click away. */
  .draftsWaiting { margin: 0; padding: 8px 12px; border-radius: 10px; background: var(--warn-wash, #fff4e0); color: var(--ink); }
  .linkBtn { background: none; border: 0; padding: 0; font: inherit; color: var(--blue-ink); text-decoration: underline; cursor: pointer; }
  .crow { display: flex; align-items: center; gap: 12px; border-bottom: 1px solid var(--line); }
  .crow > button:first-child { flex: 1; display: grid; gap: 2px; text-align: left; background: none; border: 0; padding: 14px 0; cursor: pointer; color: var(--ink); font: inherit; }
  .crow > button:first-child:hover b { text-decoration: underline; }
  .crow b { font-weight: 500; font-size: 1.05rem; }
  /* Edition picker: links in the text and related editions. */
  .picker { border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); padding: 12px; margin: 0 0 10px; }
  .picker input[type="search"] { flex: 1; }
  .picker .crow > button:first-child { padding: 10px 0; }
  ol.list { list-style: none; padding: 0; }
  .tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .tile { display: grid; gap: 4px; text-align: left; padding: 18px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--card); cursor: pointer; color: var(--ink); }
  .tile:hover { border-color: var(--ink); }
  .tile b { font: 600 2rem/1 var(--sans); }
  .tile span { font: 500 .86rem var(--sans); color: var(--muted); }
  @media (max-width: 760px) { .tiles { grid-template-columns: 1fr 1fr; } .publish { justify-items: start; text-align: left; } }
  .dataTable { width: 100%; max-width: 720px; border-collapse: collapse; margin: 12px 0; font: 500 .92rem var(--sans); }
  .dataTable th, .dataTable td { padding: 9px 12px; border-bottom: 1px solid var(--line); text-align: left; }
  .dataTable th { font-weight: 600; color: var(--muted); font-size: .82rem; }
  .dataTable td.num, .dataTable th:not(:first-child) { text-align: right; font-variant-numeric: tabular-nums; }
  .facts { display: grid; grid-template-columns: minmax(120px, 200px) 1fr; gap: 6px 16px; margin: 16px 0; }
  .facts dt { font: 600 .86rem var(--sans); color: var(--muted); }
  .facts dd { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  @media (max-width: 600px) { .facts { grid-template-columns: 1fr; } .facts dd { margin-bottom: 8px; } }
  .mdPreview { margin: 0; padding: 16px 20px; border: 1px solid var(--line-2); border-radius: 8px; max-height: 70vh; overflow: auto; background: var(--paper); }
  details.panel > summary { cursor: pointer; font-family: var(--sans); }
</style>
