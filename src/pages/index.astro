---
import Base from '../layouts/Base.astro';
import Subscribe from '../components/Subscribe.astro';
import OppCard from '../components/OppCard.astro';
import BeatRule from '../components/BeatRule.astro';
import Accent from '../components/Accent.astro';
import PartnerLogos from '../components/PartnerLogos.astro';
import { loadSite, authorsFor, fmtDate, openOpportunities } from '../lib/data';
import { TOPICS, START_ROLES, HOME_THRESHOLD, topicSlug } from '../lib/taxonomy';
import { thumb } from '../lib/images';
import { lines, commaList, plain } from '../lib/copy';

const site = await loadSite();
const { articles, copy, settings } = site;
const [lead, ...rest] = articles;
const pins = articles.filter((a) => a.pinned).slice(0, 3);
const carousel = rest.slice(0, 10);
const start = START_ROLES.map((r) => ({ ...r, items: articles.filter((a) => a.startFor.includes(r.role)).slice(0, 3) })).filter((s) => s.items.length);
const opps = openOpportunities(site);
const showOpps = opps.length >= HOME_THRESHOLD;
const showLib = site.resources.length >= HOME_THRESHOLD;
const leadAuthors = lead ? authorsFor(site, lead) : [];
const leadPic = lead?.image ? thumb(lead.image, 680) : null;
const emph = commaList(copy.heroRotate)[0] || 'digital health';
const fmtNum = (n: number) => n.toLocaleString('en-GB');

// Hero glass cards point at three real things: the newest edition, an essential read, and the next deadline.
const essential = pins.find((a) => a.id !== lead?.id);
const nextOpp = opps.find((o) => o.deadline);
const glassCards = [
  lead && { cls: 'g1', label: 'Latest edition', title: lead.title, href: `/editions/${lead.id}/` },
  essential && { cls: 'g2', label: 'Essential read', title: essential.title, href: `/editions/${essential.id}/` },
  nextOpp && { cls: 'g3', label: `Closes ${fmtDate(nextOpp.deadline, { day: 'numeric', month: 'short' })}`, title: nextOpp.title, href: `/opportunities/#opp-${nextOpp.id}` },
].filter(Boolean) as { cls: string; label: string; title: string; href: string }[];

// The statement lights up word by word; *asterisked* words are the brand-blue highlight.
let inHl = false;
const statementWords = copy.statement.split(/\s+/).filter(Boolean).map((w) => {
  const opens = w.startsWith('*'), closes = w.endsWith('*') || /\*[.,;:!?]$/.test(w);
  if (opens) inHl = true;
  const word = { text: w.replace(/\*/g, ''), hl: inHl };
  if (closes) inHl = false;
  return word;
});

// Topic sparklines: editions per quarter across the archive.
const quarter = (iso: string) => Number(iso.slice(0, 4)) * 4 + Math.floor((Number(iso.slice(5, 7)) - 1) / 3);
const qs = articles.map((a) => quarter(a.publishedAt));
const q0 = Math.min(...qs), q1 = Math.max(...qs);
const vitals = TOPICS.map((t) => {
  const mine = articles.filter((a) => a.topic === t);
  const counts = Array.from({ length: q1 - q0 + 1 }, (_, i) => mine.filter((a) => quarter(a.publishedAt) === q0 + i).length);
  const peak = Math.max(1, ...counts);
  const pts = counts.map((c, i) => [counts.length > 1 ? (i / (counts.length - 1)) * 100 : 50, 36 - (c / peak) * 30] as const);
  const line = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
  return { t, n: mine.length, last: mine[0], line, area: `${line} L100 40 L0 40 Z` };
});
const Beat = 'M2 22h10l4-10 6 20 6-28 6 26 3-8h11';
// Stat circle: the numbers it rolls through.
const stats = [
  { n: String(settings.editionsTotal), label: 'Editions on LinkedIn and Substack' },
  ...(settings.subscribers > 0 ? [{ n: fmtNum(settings.subscribers), label: `Subscribers${settings.subscribersLabel ? `, ${settings.subscribersLabel}` : ''}` }] : []),
  { n: String(TOPICS.length), label: 'Topics we follow' },
];
// Image reel: pictures from recent editions.
const reelPics = articles.filter((a) => a.image).slice(0, 6).map((a) => thumb(a.image, 1100));
// Topic rows show a picture from each topic's latest edition while hovered.
---
<Base>
  <!-- Hero: headline and subscribe on the left; the heartbeat as one bold shape among frosted cards on the right. -->
  <section class="studioHero" data-glow>
    <div class="glowSpot" aria-hidden="true"></div>
    <div class="wrap heroCols">
      <div>
        <p class="kicker" data-hero-fade><span class="pulse-dot" aria-hidden="true"></span> Publication · Knowledge library · Community</p>
        <h1 class="display hero-title">
          <span class="ln"><span>{copy.heroL1}</span></span>
          <span class="ln blue"><span>{emph}</span></span>
          <span class="ln"><span>{copy.heroL3}</span></span>
        </h1>
        <p class="lede" data-hero-fade>{copy.lede}</p>
        <div class="statRoll" data-statroll data-hero-fade aria-hidden="true">
          <div class="disc"><ul>{stats.map((x) => <li class="num">{x.n}</li>)}</ul></div>
          <div class="lbls"><ul>{stats.map((x) => <li>{x.label}</li>)}</ul></div>
        </div>
        <ul class="badges" data-hero-fade>
          <li><b class="num">{settings.editionsTotal}</b>Editions on LinkedIn and Substack</li>
          {settings.subscribers > 0 && <li><b class="num">{fmtNum(settings.subscribers)}</b>Subscribers{settings.subscribersLabel && `, ${settings.subscribersLabel}`}</li>}
          <li><b class="num">{TOPICS.length}</b>Topics we follow</li>
        </ul>
        <div data-hero-fade>
          <p class="label" style="margin-bottom:12px">{plain(copy.subTitle)}</p>
          <Subscribe id="sub-hero" />
        </div>
      </div>
      <div class="stage" data-stage>
        <svg class="bigBeatShape" viewBox="0 0 600 600" aria-hidden="true" data-depth="6">
          <defs>
            <linearGradient id="beatGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#7cc8f2" />
              <stop offset=".5" stop-color="#298fc9" />
              <stop offset="1" stop-color="#0f5a8a" />
            </linearGradient>
          </defs>
          <path d="M-40 300 H190 L268 470 L350 70 L436 560 L486 300 H660" pathLength="1" data-beat />
        </svg>
        {glassCards.map((g) => (
          <a class:list={['glass', g.cls]} href={g.href} aria-label={`${g.label}: ${g.title}`} data-depth={g.cls === 'g2' ? '18' : g.cls === 'g1' ? '10' : '26'}>
            <span class="gl"><span>{g.label}</span><b>{g.title}</b></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Image reel: a pill-shaped frame of edition pictures grows to fill the screen as you scroll. -->
  {reelPics.length > 0 && (
    <section class="reel" data-reel aria-label="Pictures from recent editions">
      <div class="stick">
        <div class="reelFrame">
          {reelPics.map((p, i) => <img src={p.src} srcset={p.srcset} sizes="100vw" alt="" loading={i ? 'lazy' : 'eager'} decoding="async" />)}
        </div>
        <p class="reelLabel" aria-hidden="true"><span class="pulse-dot"></span>Scroll to open</p>
        <div class="reelCap"><p>Field lessons <span class="accent">from</span> the people doing the work</p></div>
      </div>
    </section>
  )}

  <!-- Statement: the Digest in one paragraph, lighting up as you read; a thick ribbon winds through behind it. -->
  <section class="statement" aria-labelledby="statement-k">
    <svg class="ribbon" viewBox="0 0 800 1200" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <path d="M560 -40 C 520 140, 300 160, 330 320 C 360 470, 640 430, 660 600 C 680 780, 420 820, 400 980 C 385 1100, 520 1160, 560 1240" pathLength="1" />
    </svg>
    <div class="wrap">
      <p class="kicker line" id="statement-k">Why the Digest exists</p>
      <p class="statementText" data-words>
        {statementWords.map((w) => <><span class:list={['w', { hl: w.hl }]}>{w.text}</span>{' '}</>)}
      </p>
      <div class="actions">
        <a class="btn" href="/about/" data-magnetic>How we work <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn line" href="/contribute/">Write for us <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  {lead && (
    <section class="section" style="padding-top:clamp(24px,4vw,48px)">
      <div class="wrap">
        <div class="lead" data-reveal>
          <a href={`/editions/${lead.id}/`} class="thumb leadThumb" aria-hidden="true" tabindex="-1">
            {leadPic ? <img src={leadPic.src} srcset={leadPic.srcset} sizes="(max-width: 860px) 100vw, 680px" alt="" width="4" height="3" decoding="async" style="width:100%;height:100%;object-fit:cover" /> : null}
          </a>
          <div>
            <p class="kicker line">Latest edition · <a class="kicker" href={`/topics/${topicSlug(lead.topic)}/`} style="letter-spacing:inherit">{lead.topic}</a></p>
            <h2><a href={`/editions/${lead.id}/`} style={`view-transition-name: ed-${lead.id}`}>{lead.title}</a></h2>
            {lead.dek && <p class="dek">{lead.dek}</p>}
            <div class="meta" style="margin:18px 0 24px">
              {leadAuthors.length > 0 && <span>{leadAuthors.map((x) => x.name).join(', ')}</span>}
              <time datetime={lead.publishedAt}>{fmtDate(lead.publishedAt)}</time>
              <span>{lead.readMins} min read</span>
            </div>
            {lead.fr && <p class="enbref" lang="fr" style="margin:0 0 24px"><b>En bref</b>{lead.fr}</p>}
            <a class="btn" href={`/editions/${lead.id}/`} data-magnetic>Read the edition <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Marquee: the six topics, sliding by. Decorative; the topic tiles below are the links. -->
  <div class="marquee" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => (
        <div class="group">
          {TOPICS.map((t, i) => (
            <>
              <span class:list={['word', { outline: i % 2 === 1 }]}>{t}</span>
              <svg class="sep" viewBox="0 0 50 40"><path d={Beat} fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </>
          ))}
        </div>
      ))}
    </div>
  </div>

  {pins.length > 0 && (
    <section class="section tint">
      <div class="ecg-paper ecg-fade" style="position:absolute;inset:0;opacity:.6" aria-hidden="true"></div>
      <div class="wrap" style="position:relative">
        <div class="secHead">
          <div><p class="kicker line">If you read three</p><h2 class="display"><Accent text={copy.pinsTitle} /></h2><p>{copy.pinsSub}</p></div>
        </div>
        <ol class="stack" data-stack>
          {pins.map((a, i) => {
            const pic = a.image ? thumb(a.image, 640) : null;
            return (
              <li class="stackCard" style={`--i:${i}`}>
                <div class="pic">{pic && <img src={pic.src} srcset={pic.srcset} sizes="(max-width: 760px) 100vw, 600px" alt="" loading="lazy" decoding="async" />}</div>
                <div class="txt">
                  <span class="no num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <svg class="draw" viewBox="0 0 120 36" aria-hidden="true"><path d="M0 20h40l6-10 8 20 8-26 8 24 5-8h45" pathLength="1" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  <h3><a href={`/editions/${a.id}/`}>{a.title}</a></h3>
                  {a.dek && <p>{a.dek}</p>}
                  <div class="meta"><span>{a.topic}</span><span>{a.readMins} min read</span></div>
                </div>
                <span class="shade" aria-hidden="true"></span>
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  )}

  <!-- Start here: the heading holds still while each role scrolls past (position: sticky; no scroll-jacking). -->
  {start.length > 0 && (
    <section class="pinStory" id="start" aria-labelledby="start-h">
      <div class="wrap">
        <div class="pinLeft">
          <p class="kicker line">New to the Digest?</p>
          <h2 class="display" id="start-h"><Accent text={copy.startTitle} /></h2>
          <p>{copy.startSub}</p>
          <a class="btn sm" href="/start/" style="margin:4px 0 18px">New to digital health? Read the guide <span class="arrow" aria-hidden="true">→</span></a>
          <span class="role" aria-live="polite" data-role-name>{start[0].role}</span>
          <div class="keepScrolling" data-keep aria-hidden="true"><span class="spin"></span>Keep scrolling</div>
        </div>
        <div class="pinRight">
          {start.map((s, i) => (
            <div class="roleBlock" id={`role-${i}`} data-role={s.role}>
              <span class="roleKicker">{String(i + 1).padStart(2, '0')} / {String(start.length).padStart(2, '0')}</span>
              <h3>For {s.role.toLowerCase()}</h3>
              <p class="blurb">{s.blurb}</p>
              <ol>
                {s.items.map((a, j) => (
                  <li><a href={`/editions/${a.id}/`}><span class="n num">{String(j + 1).padStart(2, '0')}</span><b>{a.title}</b><span class="go" aria-hidden="true">→</span></a></li>
                ))}
              </ol>
            </div>
          ))}
        </div>
        <div class="pinRail" aria-hidden="true"><span data-rail></span></div>
      </div>
    </section>
  )}

  <section class="section tint">
    <div class="wrap">
      <div class="secHead">
        <div><p class="kicker line">Vital signs</p><h2 class="display"><Accent text={copy.topicsTitle} /></h2><p>{copy.topicsSub}</p></div>
        <a class="more" href="/editions/">The full archive <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <!-- One card per topic: name, how many editions, how active it has been, and the latest edition, all at a glance. -->
      <ul class="topicGrid">
        {vitals.map(({ t, n, last, line }, i) => (
          <li class="topicCard" data-reveal>
            <a href={`/topics/${topicSlug(t)}/`}>
              <span class="tcTop"><span class="tn num">{String(i + 1).padStart(2, '0')}</span><span class="tc">{n} {n === 1 ? 'edition' : 'editions'}</span></span>
              <span class="tt">{t}</span>
              <svg class="spark" viewBox="0 0 100 40" preserveAspectRatio="none" role="img" aria-label={`Editions per quarter on ${t}`}><path d={line} /></svg>
              {last && <span class="tLatest"><span class="lbl">Latest</span><span class="ttl">{last.title}</span><span class="when">{fmtDate(last.publishedAt, { month: 'short', year: 'numeric' })}</span></span>}
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Carousel: recent editions as large image cards. Native horizontal scroll with snap; buttons and drag on desktop. -->
  {carousel.length > 0 && (
    <section class="section carousel" aria-labelledby="latest-h">
      <div class="wrap carouselHead">
        <div class="secHead" style="margin:0">
          <div><p class="kicker line">From the archive</p><h2 class="display" id="latest-h"><Accent text={copy.latestTitle} /></h2><p>{copy.latestSub}</p></div>
        </div>
        <div class="carouselNav">
          <button type="button" data-car="-1" aria-label="Previous editions"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg></button>
          <button type="button" data-car="1" aria-label="Next editions"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg></button>
          <a class="more" href="/editions/" style="margin-left:12px">All editions <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="carouselTrack" data-track tabindex="0" aria-label="Recent editions, scroll sideways">
        {carousel.map((a) => {
          const pic = a.image ? thumb(a.image, 420) : null;
          return (
            <a class:list={['slide', { blank: !pic }]} href={`/editions/${a.id}/`}>
              <span class="sPic">
                {pic && <img src={pic.src} srcset={pic.srcset} sizes="(max-width: 640px) 78vw, 340px" alt="" loading="lazy" decoding="async" draggable="false" />}
                <span class="go" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
              </span>
              <span class="sBody">
                <span class="sTopic">{a.topic}</span>
                <h3 style={`view-transition-name: ed-${a.id}`}>{a.title}</h3>
                {a.dek && <span class="sDek">{a.dek}</span>}
                <span class="sMeta">{fmtDate(a.publishedAt, { day: 'numeric', month: 'short', year: 'numeric' })} · {a.readMins} min read</span>
              </span>
            </a>
          );
        })}
      </div>
      <div class="wrap"><div class="carouselBar" aria-hidden="true"><span data-bar></span></div></div>
    </section>
  )}

  {showOpps && (
    <section class="section tint">
      <div class="wrap">
        <div class="secHead">
          <div><p class="kicker line">Opportunity board</p><h2 class="display"><Accent text={copy.oppTitle} /></h2><p>Every listing shows the date an editor last checked it against the source.</p></div>
          <a class="more" href="/opportunities/">All opportunities <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="oppGrid">{opps.slice(0, 4).map((o) => <OppCard o={o} compact />)}</div>
      </div>
    </section>
  )}

  {showLib && (
    <section class="section">
      <div class="wrap">
        <div class="secHead"><div><p class="kicker line">Knowledge library</p><h2 class="display">{copy.libTitle}</h2><p>{copy.libSub}</p></div><a class="more" href="/library/">Open the library <span class="arrow" aria-hidden="true">→</span></a></div>
      </div>
    </section>
  )}

  <section class="giantWord" aria-labelledby="together-h">
    <div class="wrap">
      <h2 id="together-h" data-giant>Together.</h2>
      <p>The Digest is written by the people building health systems, for each other.</p>
    </div>
  </section>

  {site.partners.length > 0 && (
    <section class="section tight" aria-label="Partners">
      <div class="wrap">
        <PartnerLogos partners={site.partners} variant="rail"
          kicker={site.partners.some((p) => p.kind === 'past') ? 'Partners and organisations we have worked with' : 'With our partners'} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <BeatRule />
      <div class="grid2" style="margin-top:clamp(40px,6vw,72px);align-items:start">
        <div data-reveal>
          <p class="kicker line">{copy.aboutTitle}</p>
          <h2 style="margin-top:12px">{copy.aboutName}</h2>
          <ul class="list" style="font:500 1rem/1.7 var(--sans);color:var(--ink-2);margin:14px 0 20px">
            {lines(copy.aboutRoles).map((r) => <li>{r}</li>)}
          </ul>
          <a class="more" href="/about/">About the Digest and our standard <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="panel" data-reveal>
          <p class="kicker">Write for the Digest</p>
          <h3 style="font-size:1.7rem;margin:10px 0 12px"><Accent text={copy.ctaTitle} /></h3>
          <p style="color:var(--ink-2)">{copy.ctaSub}</p>
          <a class="btn" href="/contribute/" data-magnetic>Pitch the Digest <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section navy wipeOpen">
    <div class="ecg-paper" style="position:absolute;inset:0;opacity:.5" aria-hidden="true"></div>
    <div class="wrap grid2" style="align-items:center;position:relative">
      <div>
        <p class="kicker line">Free, about once a week</p>
        <h2 class="display" style="font-size:clamp(2.4rem,5.5vw,4.4rem);margin-top:12px"><Accent text={copy.subTitle} /></h2>
      </div>
      <div>
        <Subscribe id="sub-foot" note={false} />
        <p class="subNote">{copy.subSub} Or follow on <a href={settings.substackUrl}>Substack</a>{settings.linkedinUrl && <> and <a href={settings.linkedinUrl}>LinkedIn</a></>}.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  // Carousel: buttons page by about one screen, a bar shows position, and a mouse can drag it like a phone.
  const track = document.querySelector<HTMLElement>('[data-track]');
  if (track) {
    const bar = document.querySelector<HTMLElement>('[data-bar]');
    const [prev, next] = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-car]'));
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const p = max > 0 ? track.scrollLeft / max : 1;
      if (bar) bar.style.transform = `scaleX(${Math.max(0.12, Math.min(1, track.clientWidth / track.scrollWidth + p * (1 - track.clientWidth / track.scrollWidth)))})`;
      prev.disabled = track.scrollLeft < 8;
      next.disabled = track.scrollLeft > max - 8;
    };
    const page = (dir: number) => track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    prev.addEventListener('click', () => page(-1));
    next.addEventListener('click', () => page(1));
    track.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
    // Mouse drag (touch already scrolls natively). A short drag still counts as a click.
    let x0 = 0, s0 = 0, moved = false, down = false;
    track.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; moved = false; x0 = e.clientX; s0 = track.scrollLeft; });
    addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 6) { moved = true; track.classList.add('dragging'); }
      if (moved) track.scrollLeft = s0 - dx;
    });
    addEventListener('pointerup', () => { if (!down) return; down = false; setTimeout(() => track.classList.remove('dragging'), 0); });
    track.addEventListener('click', (e) => { if (moved) { e.preventDefault(); moved = false; } }, true);
  }

  // Start here: name the role in view and fill the rail as the section scrolls past.
  const story = document.getElementById('start');
  if (story) {
    const name = story.querySelector<HTMLElement>('[data-role-name]');
    const rail = story.querySelector<HTMLElement>('[data-rail]');
    const keep = story.querySelector<HTMLElement>('[data-keep]');
    const blocks = Array.from(story.querySelectorAll<HTMLElement>('[data-role]'));
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      if (name) name.textContent = (e.target as HTMLElement).dataset.role || '';
      if (keep && e.target === blocks[blocks.length - 1]) keep.classList.add('done');
    }), { rootMargin: '-45% 0px -45% 0px' });
    blocks.forEach((b) => io.observe(b));
    let ticking = false;
    const fill = () => {
      ticking = false;
      const r = story.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.5 - r.top) / (r.height - innerHeight * 0.5)));
      if (rail) rail.style.transform = `scaleY(${p})`;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(fill); } }, { passive: true });
    fill();
  }
</script>
