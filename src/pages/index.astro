---
import Base from '../layouts/Base.astro';
import EditionCard from '../components/EditionCard.astro';
import Subscribe from '../components/Subscribe.astro';
import OppCard from '../components/OppCard.astro';
import BeatRule from '../components/BeatRule.astro';
import { loadSite, authorsFor, fmtDate, openOpportunities } from '../lib/data';
import { TOPICS, START_ROLES, HOME_THRESHOLD, topicSlug } from '../lib/taxonomy';
import { thumb } from '../lib/images';
import { lines, commaList } from '../lib/copy';

const site = await loadSite();
const { articles, copy, settings } = site;
const [lead, ...rest] = articles;
const side = rest.slice(0, 3);
const pins = articles.filter((a) => a.pinned).slice(0, 3);
const latest = rest.slice(3).filter((a) => !pins.includes(a)).slice(0, 6);
const start = START_ROLES.map((r) => ({ ...r, items: articles.filter((a) => a.startFor.includes(r.role)).slice(0, 3) }));
const firstStart = Math.max(0, start.findIndex((s) => s.items.length));
const opps = openOpportunities(site);
const showOpps = opps.length >= HOME_THRESHOLD;
const showLib = site.resources.length >= HOME_THRESHOLD;
const leadAuthors = lead ? authorsFor(site, lead) : [];
const leadPic = lead?.image ? thumb(lead.image, 680) : null;
const emph = commaList(copy.heroRotate)[0] || 'digital health';

// Topic sparklines: editions per quarter across the archive, one small trend line per topic.
const quarter = (iso: string) => Number(iso.slice(0, 4)) * 4 + Math.floor((Number(iso.slice(5, 7)) - 1) / 3);
const qs = articles.map((a) => quarter(a.publishedAt));
const q0 = Math.min(...qs), q1 = Math.max(...qs);
const vitals = TOPICS.map((t) => {
  const mine = articles.filter((a) => a.topic === t);
  const counts = Array.from({ length: q1 - q0 + 1 }, (_, i) => mine.filter((a) => quarter(a.publishedAt) === q0 + i).length);
  const peak = Math.max(1, ...counts);
  const pts = counts.map((c, i) => [counts.length > 1 ? (i / (counts.length - 1)) * 100 : 50, 36 - (c / peak) * 30] as const);
  const line = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
  return { t, n: mine.length, last: mine[0], line, area: `${line} L100 40 L0 40 Z` };
});
---
<Base>
  <section class="hero" data-glow>
    <div class="ecg-paper ecg-fade" aria-hidden="true"></div>
    <div class="glowSpot" aria-hidden="true"></div>
    <div class="wrap">
      <p class="kicker" data-hero-fade><span class="pulse-dot" aria-hidden="true"></span> Publication · Knowledge library · Community</p>
      <h1 class="display">
        <span class="ln">{copy.heroL1}</span>
        <span class="ln blue">{emph}</span>
        <span class="ln">{copy.heroL3}</span>
      </h1>
      <div class="heroFoot">
        <div data-hero-fade>
          <p class="lede">{copy.lede}</p>
          <div class="stats">
            {settings.subscribers > 0 && (
              <div class="stat"><b class="num" data-count={settings.subscribers}>{settings.subscribers.toLocaleString('en-GB')}</b><span>Subscribers{settings.subscribersLabel && `, ${settings.subscribersLabel}`}</span></div>
            )}
            <div class="stat"><b class="num" data-count={settings.editionsTotal}>{settings.editionsTotal}</b><span>Editions on LinkedIn and Substack</span></div>
          </div>
        </div>
        <div data-hero-fade>
          <p class="label" style="margin-bottom:12px">{copy.subTitle}</p>
          <Subscribe id="sub-hero" />
        </div>
      </div>
    </div>
  </section>

  {lead && (
    <section class="section">
      <div class="wrap">
        <div class="lead" data-reveal>
          <a href={`/editions/${lead.id}/`} class="thumb leadThumb" aria-hidden="true" tabindex="-1">
            {leadPic ? <img src={leadPic.src} srcset={leadPic.srcset} sizes="(max-width: 860px) 100vw, 680px" alt="" width="4" height="3" fetchpriority="high" decoding="async" style="width:100%;height:100%;object-fit:cover" /> : null}
          </a>
          <div>
            <p class="kicker line">Latest edition · <a class="kicker" href={`/topics/${topicSlug(lead.topic)}/`} style="letter-spacing:inherit">{lead.topic}</a></p>
            <h2><a href={`/editions/${lead.id}/`} style={`view-transition-name: ed-${lead.id}`}>{lead.title}</a></h2>
            {lead.dek && <p class="dek">{lead.dek}</p>}
            <div class="meta" style="margin:18px 0 24px">
              {leadAuthors.length > 0 && <span>{leadAuthors.map((x) => x.name).join(', ')}</span>}
              <time datetime={lead.publishedAt}>{fmtDate(lead.publishedAt)}</time>
              <span>{lead.readMins} min read</span>
            </div>
            {lead.fr && <p class="enbref" lang="fr" style="margin:0 0 24px"><b>En bref</b>{lead.fr}</p>}
            <a class="btn" href={`/editions/${lead.id}/`} data-magnetic>Read the edition <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
        {side.length > 0 && (
          <div class="grid3" style="margin-top:clamp(48px,6vw,80px)">
            {side.map((a) => <EditionCard site={site} a={a} width={400} />)}
          </div>
        )}
      </div>
    </section>
  )}

  {pins.length > 0 && (
    <section class="section tint">
      <div class="ecg-paper ecg-fade" style="position:absolute;inset:0;opacity:.6" aria-hidden="true"></div>
      <div class="wrap" style="position:relative">
        <div class="secHead">
          <div><p class="kicker line">If you read three</p><h2 class="display">{copy.pinsTitle}</h2><p>{copy.pinsSub}</p></div>
        </div>
        <ol class="list essentials">
          {pins.map((a) => (
            <li data-reveal>
              <a href={`/editions/${a.id}/`}>{a.title}</a>
              {a.dek && <p>{a.dek}</p>}
              <div class="meta" style="margin-top:12px"><span>{a.topic}</span><span>{a.readMins} min</span></div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {start.some((s) => s.items.length) && (
    <section class="section" id="start">
      <div class="wrap startGrid">
        <div data-reveal>
          <p class="kicker line">New to the Digest?</p>
          <h2 class="display" style="font-size:clamp(2.2rem,5vw,4rem);margin:12px 0 18px">{copy.startTitle}</h2>
          <p style="color:var(--muted);font-size:1.08rem">{copy.startSub}</p>
          <div class="seg" role="tablist" aria-label="Choose your role" style="margin-top:18px">
            <span class="thumbBg" aria-hidden="true"></span>
            {start.map((s, i) => (
              <button type="button" role="tab" id={`st-${i}`} aria-controls={`sp-${i}`} aria-selected={i === firstStart ? 'true' : 'false'} disabled={!s.items.length}>{s.role}</button>
            ))}
          </div>
        </div>
        <div>
          {start.map((s, i) => (
            <div role="tabpanel" id={`sp-${i}`} aria-labelledby={`st-${i}`} hidden={i !== firstStart} class="startPanel">
              <p class="blurb" style="margin:0 0 20px">{s.blurb}</p>
              <ol class="list startList">
                {s.items.map((a, j) => (
                  <li><a href={`/editions/${a.id}/`}><span class="n num">{String(j + 1).padStart(2, '0')}</span><span><b>{a.title}</b>{a.dek && <small>{a.dek}</small>}</span><span class="go" aria-hidden="true">→</span></a></li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section tint">
    <div class="wrap">
      <div class="secHead">
        <div><p class="kicker line">Vital signs</p><h2 class="display">{copy.topicsTitle}</h2><p>{copy.topicsSub}</p></div>
        <a class="more" href="/editions/">The full archive <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="vitals">
        {vitals.map(({ t, n, last, line, area }) => (
          <a class="vital" href={`/topics/${topicSlug(t)}/`} data-reveal>
            <div class="top"><b>{t}</b><span class="count num">{n}</span></div>
            <svg viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true"><path class="area" d={area} /><path d={line} pathLength="1" data-spark /></svg>
            <div class="foot"><span>{last ? `Latest ${fmtDate(last.publishedAt, { month: 'short', year: 'numeric' })}` : 'Nothing yet'}</span><span class="go" aria-hidden="true">→</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="secHead">
          <div><p class="kicker line">From the archive</p><h2 class="display">{copy.latestTitle}</h2><p>{copy.latestSub}</p></div>
          <a class="more" href="/editions/">All editions <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="grid3">{latest.map((a) => <EditionCard site={site} a={a} />)}</div>
      </div>
    </section>
  )}

  {showOpps && (
    <section class="section tint">
      <div class="wrap">
        <div class="secHead">
          <div><p class="kicker line">Opportunity board</p><h2 class="display">{copy.oppTitle}</h2><p>Every listing shows the date an editor last checked it against the source.</p></div>
          <a class="more" href="/opportunities/">All opportunities <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="oppGrid">{opps.slice(0, 4).map((o) => <OppCard o={o} compact />)}</div>
      </div>
    </section>
  )}

  {showLib && (
    <section class="section">
      <div class="wrap">
        <div class="secHead"><div><p class="kicker line">Knowledge library</p><h2 class="display">{copy.libTitle}</h2><p>{copy.libSub}</p></div><a class="more" href="/library/">Open the library <span class="arrow" aria-hidden="true">→</span></a></div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <BeatRule />
      <div class="grid2" style="margin-top:clamp(40px,6vw,72px);align-items:start">
        <div data-reveal>
          <p class="kicker line">{copy.aboutTitle}</p>
          <h2 style="margin-top:12px">{copy.aboutName}</h2>
          <ul class="list" style="font:500 1rem/1.7 var(--sans);color:var(--ink-2);margin:14px 0 20px">
            {lines(copy.aboutRoles).map((r) => <li>{r}</li>)}
          </ul>
          <a class="more" href="/about/">About the Digest and our standard <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="panel" data-reveal>
          <p class="kicker">Write for the Digest</p>
          <h3 style="font-size:1.7rem;margin:10px 0 12px">{copy.ctaTitle}</h3>
          <p style="color:var(--ink-2)">{copy.ctaSub}</p>
          <a class="btn" href="/contribute/" data-magnetic>Pitch the Digest <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section navy">
    <div class="ecg-paper" style="position:absolute;inset:0;opacity:.5" aria-hidden="true"></div>
    <div class="wrap grid2" style="align-items:center;position:relative">
      <div data-reveal>
        <p class="kicker line">Free, about once a week</p>
        <h2 class="display" style="font-size:clamp(2.4rem,5.5vw,4.4rem);margin-top:12px">{copy.subTitle}</h2>
      </div>
      <div data-reveal>
        <Subscribe id="sub-foot" note={false} />
        <p class="subNote">{copy.subSub} Or follow on <a href={settings.substackUrl}>Substack</a>{settings.linkedinUrl && <> and <a href={settings.linkedinUrl}>LinkedIn</a></>}.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  // Start here: a segmented control whose highlight slides to the chosen role. Arrow keys move between roles.
  const seg = document.querySelector<HTMLElement>('#start .seg');
  if (seg) {
    const tabs = Array.from(seg.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const bg = seg.querySelector<HTMLElement>('.thumbBg')!;
    const place = (t: HTMLButtonElement) => { bg.style.width = `${t.offsetWidth}px`; bg.style.transform = `translateX(${t.offsetLeft}px)`; };
    const select = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(x.getAttribute('aria-controls')!)!;
        panel.hidden = !on;
        if (on) { panel.classList.remove('enter'); void panel.offsetWidth; panel.classList.add('enter'); }
      });
      place(t);
      if (focus) t.focus();
    };
    tabs.forEach((t) => {
      t.tabIndex = t.getAttribute('aria-selected') === 'true' ? 0 : -1;
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        const live = tabs.filter((x) => !x.disabled);
        select(live[(live.indexOf(t) + d + live.length) % live.length], true);
      });
    });
    const initial = tabs.find((t) => t.getAttribute('aria-selected') === 'true') || tabs[0];
    place(initial);
    addEventListener('resize', () => place(tabs.find((t) => t.getAttribute('aria-selected') === 'true')!));
    document.fonts?.ready.then(() => place(tabs.find((t) => t.getAttribute('aria-selected') === 'true')!));
  }
</script>
