---
import Base from '../../layouts/Base.astro';
import EditionCard from '../../components/EditionCard.astro';
import Subscribe from '../../components/Subscribe.astro';
import SponsorBox from '../../components/SponsorBox.astro';
import AdSlot from '../../components/AdSlot.astro';
import { loadSite, authorsFor, fmtDate, relatedTo, seriesOf, apaCitation, bibtex, searchDescription, sponsorFor, type Article } from '../../lib/data';
import { renderMarkdown, outline, splitForAd } from '../../lib/markdown';
import { topicSlug } from '../../lib/taxonomy';

export async function getStaticPaths() {
  const site = await loadSite();
  return site.articles.map((a) => ({ params: { id: a.id }, props: { a } }));
}
const { a } = Astro.props as { a: Article };
const site = await loadSite();
const authors = authorsFor(site, a);
const rel = relatedTo(site, a);
const related = rel.list;
// Series: every published part, in order, with this edition's neighbours inside the series.
const parts = seriesOf(site, a);
const at = parts.findIndex((x) => x.id === a.id);
const partNo = (x: Article, i: number) => x.seriesPart ?? i + 1;
const html = a.body ? renderMarkdown(a.body) : '';
const toc = outline(html);
const sponsor = sponsorFor(site, a);
// One labelled ad at a section break near the middle of long pieces (only once AdSense is set up).
const halves = site.settings.revenue.adsense.client && site.settings.revenue.adsense.slotArticle ? splitForAd(html) : null;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const apa = apaCitation(a, authors, canonical);
const bib = bibtex(a, authors, canonical);
// Older and newer editions, for reading on.
const idx = site.articles.findIndex((x) => x.id === a.id);
const newer = idx > 0 ? site.articles[idx - 1] : null;
const older = site.articles[idx + 1] || null;
const enc = encodeURIComponent;
const share = [
  { label: 'Share on LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(canonical)}`, icon: 'M6.94 8.5H3.56V20h3.38V8.5zM5.25 3.5a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92zM20.44 13.1c0-3.08-1.64-4.84-4.27-4.84-1.27 0-2.27.6-2.83 1.43V8.5H9.97V20h3.37v-6.02c0-1.6.76-2.56 2.04-2.56 1.2 0 1.69.85 1.69 2.56V20h3.37v-6.9z' },
  { label: 'Share on WhatsApp', href: `https://wa.me/?text=${enc(`${a.title} ${canonical}`)}`, icon: 'M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3zm4.4 12.6c-.2.5-1.1 1-1.6 1-.4.1-.9.1-1.5-.1-2.6-1-4.3-3.6-4.4-3.8-.1-.2-1-1.4-1-2.6s.6-1.8.9-2.1c.2-.2.5-.3.6-.3h.5c.1 0 .3 0 .5.4l.7 1.7c.1.1.1.3 0 .4l-.3.5-.3.4c-.1.1-.2.3-.1.5.2.3.7 1.1 1.4 1.7.9.8 1.7 1.1 2 1.2.2.1.4.1.5-.1l.7-.8c.2-.2.3-.2.5-.1l1.6.8c.2.1.4.2.4.3.1.1.1.6-.1 1.1z' },
  { label: 'Share on X', href: `https://twitter.com/intent/tweet?url=${enc(canonical)}&text=${enc(a.title)}`, icon: 'M17.8 3h3.1l-6.7 7.6L22 21h-6.1l-4.8-6.3L5.6 21H2.5l7.2-8.2L2 3h6.2l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: a.title,
  description: searchDescription(a),
  datePublished: a.publishedAt,
  inLanguage: 'en',
  articleSection: a.topic,
  mainEntityOfPage: canonical,
  image: [new URL(`/og/${a.id}.png`, Astro.site).href],
  author: authors.map((x) => ({ '@type': 'Person', name: x.name, jobTitle: x.role || undefined, url: new URL(`/authors/${x.id}/`, Astro.site).href })),
  publisher: { '@type': 'Organization', name: 'Digital Health Digest', url: Astro.site?.href },
  sameAs: [a.substackUrl, a.linkedinUrl].filter(Boolean),
  ...(parts.length > 1 ? { isPartOf: { '@type': 'CreativeWorkSeries', name: a.series }, position: partNo(a, at) } : {}),
};
const initials = (n: string) => n.replace(/^Dr\.?\s+/i, '').split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---
<Base title={a.title} searchTitle={a.seoTitle} description={searchDescription(a)} image={`/og/${a.id}.png`} type="article" jsonLd={jsonLd} progress
  breadcrumbs={[{ name: 'Editions', href: '/editions/' }, { name: a.topic, href: `/topics/${topicSlug(a.topic)}/` }, { name: a.title, href: `/editions/${a.id}/` }]}>
  <Fragment slot="head">
    {html.includes('substackcdn.com') && <link rel="preconnect" href="https://substackcdn.com" crossorigin />}
    <meta property="article:published_time" content={a.publishedAt} />
    <meta property="article:section" content={a.topic} />
    {/* Read by Google Scholar and reference managers (Zotero, Mendeley). */}
    <meta name="citation_title" content={a.title} />
    {authors.map((x) => <meta name="citation_author" content={x.name} />)}
    <meta name="citation_publication_date" content={a.publishedAt.replaceAll('-', '/')} />
    <meta name="citation_publisher" content="Digital Health Digest" />
  </Fragment>
  <article class="article" data-pagefind-body>
    <div class="wrap">
      <header>
        <a class="kicker line" href={`/topics/${topicSlug(a.topic)}/`} data-pagefind-filter="topic">{a.topic}</a>
        <h1 data-pagefind-meta="title" style={`view-transition-name: ed-${a.id}`}>{a.title}</h1>
        {a.dek && <p class="dek">{a.dek}</p>}
        {parts.length > 1 && <p class="seriesTag"><a href="#series">Part {partNo(a, at)} of the series <b>{a.series}</b></a></p>}
        <div class="byline">
          {authors.length > 0 && (
            <span class="who">
              <span class="avatar sm" aria-hidden="true">{authors[0].photoUrl ? <img src={authors[0].photoUrl} alt="" /> : initials(authors[0].name)}</span>
              <span>By {authors.map((x, i) => <>{i > 0 && ', '}<a href={`/authors/${x.id}/`}>{x.name}</a></>)}</span>
            </span>
          )}
          <time datetime={a.publishedAt} data-pagefind-meta="date">{fmtDate(a.publishedAt)}</time>
          <span>{a.readMins} min read</span>
          <span class="share" data-pagefind-ignore>
            <button class="iconBtn" type="button" data-copy={canonical} aria-label="Copy link to this edition">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1"/><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1"/></svg>
            </button>
            {share.map((x) => (
              <a class="iconBtn" href={x.href} target="_blank" rel="noopener" aria-label={x.label}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={x.icon} /></svg>
              </a>
            ))}
          </span>
        </div>
        {a.fr && <p class="enbref" lang="fr"><b>En bref</b>{a.fr}</p>}
        <SponsorBox sponsor={sponsor} />
      </header>

      {html ? (
        <div class="articleBody">
          {halves
            ? <div class="prose"><Fragment set:html={halves[0]} /><AdSlot slot="article" /><Fragment set:html={halves[1]} /></div>
            : <div class="prose" set:html={html} />}
          {toc.length >= 3 && (
            <nav class="toc" aria-label="In this edition" data-pagefind-ignore>
              <p>In this edition</p>
              <ol>{toc.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}</ol>
            </nav>
          )}
        </div>
      ) : (
        <div class="readOn" data-pagefind-ignore>
          <h2 style="font-size:1.3rem">The full edition is on {a.substackUrl ? 'Substack' : 'LinkedIn'}</h2>
          <p>We are bringing every edition onto this site. Until this one arrives, read it in full at the original.</p>
          <div class="actions">
            {a.substackUrl && <a class="btn" href={a.substackUrl} rel="noopener">Read on Substack ↗</a>}
            {a.linkedinUrl && <a class="btn line" href={a.linkedinUrl} rel="noopener">Read on LinkedIn ↗</a>}
          </div>
        </div>
      )}

      <div class="endmatter" data-pagefind-ignore>
        {html && (a.substackUrl || a.linkedinUrl) && (
          <p class="meta" style="margin-bottom:24px">
            Also published on {a.substackUrl && <a href={a.substackUrl} rel="noopener">Substack</a>}{a.substackUrl && a.linkedinUrl && ' and '}{a.linkedinUrl && <a href={a.linkedinUrl} rel="noopener">LinkedIn</a>}. Join the discussion there.
          </p>
        )}
        {parts.length > 1 && (
          <nav class="seriesBox" id="series" aria-labelledby="series-h">
            <p class="kicker">A series in {parts.length} parts so far</p>
            <h2 id="series-h">{a.series}</h2>
            <ol>
              {parts.map((x, i) => (
                <li>
                  <span class="no">{partNo(x, i)}</span>
                  {x.id === a.id
                    ? <span aria-current="page"><b>{x.title}</b> <span class="meta">You are reading this</span></span>
                    : <a href={`/editions/${x.id}/`}>{x.title}</a>}
                </li>
              ))}
            </ol>
            {at < parts.length - 1 && <a class="btn sm" href={`/editions/${parts[at + 1].id}/`}>Next in the series: part {partNo(parts[at + 1], at + 1)} <span class="arrow" aria-hidden="true">→</span></a>}
          </nav>
        )}
        {authors.map((x) => (
          <div class="authorCard">
            <div class="avatar">{x.photoUrl ? <img src={x.photoUrl} alt="" width="56" height="56" /> : initials(x.name)}</div>
            <div>
              <h3><a href={`/authors/${x.id}/`} style="color:inherit;text-decoration:none">{x.name}</a></h3>
              <div class="meta">{[x.role, x.org, x.country].filter(Boolean).map((v) => <span>{v}</span>)}</div>
              {x.bio && <p>{x.bio}</p>}
            </div>
          </div>
        ))}
        <details class="cite">
          <summary>Cite this edition</summary>
          <div class="citeBody">
            <p class="label">APA</p>
            <p class="citeText">{apa}</p>
            <button class="btn line sm" type="button" data-copy-text={apa}>Copy citation</button><span class="copyMsg" role="status"></span>
            <p class="label">BibTeX</p>
            <pre>{bib}</pre>
            <button class="btn line sm" type="button" data-copy-text={bib}>Copy BibTeX</button><span class="copyMsg" role="status"></span>
          </div>
        </details>
        <div class="panel" style="margin-top:28px">
          <p class="kicker">Free, about once a week</p>
          <h2 style="font-size:1.6rem;margin:8px 0 16px">Get the next edition in your inbox</h2>
          <Subscribe id="sub-article" />
        </div>
        {(older || newer) && (
          <nav class="readNext" aria-label="More editions">
            {older ? <a href={`/editions/${older.id}/`}><span class="kicker">← Previous</span><b>{older.title}</b></a> : <span></span>}
            {newer ? <a href={`/editions/${newer.id}/`} class="nx"><span class="kicker">Next →</span><b>{newer.title}</b></a> : <span></span>}
          </nav>
        )}
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section" data-pagefind-ignore>
      <div class="wrap">
        <div class="secHead"><div><p class="kicker line">Keep reading</p><h2>{rel.picked ? 'Related reading' : `More on ${a.topic}`}</h2></div><a class="more" href={`/topics/${topicSlug(a.topic)}/`}>All {a.topic} <span class="arrow" aria-hidden="true">→</span></a></div>
        <div class="grid3">{related.map((x) => <EditionCard site={site} a={x} showFr={false} transition={false} />)}</div>
      </div>
    </section>
  )}
</Base>

<script>
  // Copy link, with the native share sheet on phones that have one.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    const url = b.dataset.copy!;
    if (navigator.share && matchMedia('(pointer: coarse)').matches) { try { await navigator.share({ url, title: document.title }); return; } catch { /* cancelled */ } }
    try { await navigator.clipboard.writeText(url); } catch { return; }
    b.classList.add('copied'); setTimeout(() => b.classList.remove('copied'), 1600);
  }));
  // Copy a citation as plain text.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-text]').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copyText!); } catch { return; }
    const msg = b.nextElementSibling as HTMLElement | null;
    if (!msg) return;
    msg.textContent = 'Copied';
    setTimeout(() => { msg.textContent = ''; }, 1600);
  }));
  // Table of contents: highlight the section being read.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [a.hash.slice(1), a]));
  if (links.size) {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.classList.remove('on'));
      links.get(e.target.id)?.classList.add('on');
    }), { rootMargin: '-15% 0px -70% 0px' });
    links.forEach((_, id) => { const h = document.getElementById(id); if (h) io.observe(h); });
  }
</script>
