---
// "Read by people at…": organisations readers work at. With logos (console, Partners, relationship
// "reader") it is an endless rail of colour logos; without, the names typed under Who reads the Digest.
// Hidden until there are at least three.
import type { Copy } from '../lib/copy';
import type { Partner } from '../lib/data';
import PartnerLogos from './PartnerLogos.astro';
interface Props { copy: Copy; orgs: Partner[]; align?: 'center' | 'start' }
const { copy, orgs, align = 'center' } = Astro.props;
const names = copy.readersAt.split('\n').map((s) => s.trim()).filter(Boolean);
const note = copy.readersNote.trim();
const logos = orgs.length >= 3;
---
{(logos || names.length >= 3) && (
  <div class:list={['readersAt', logos ? 'start' : align]}>
    {logos
      ? <PartnerLogos partners={orgs} variant="rail" tone="color" kicker="Read by people at" />
      : <>
          <p class="kicker">Read by people at</p>
          <ul class="names">{names.map((o) => <li>{o}</li>)}</ul>
        </>}
    {note && <p class="note">{note}</p>}
  </div>
)}

<style>
  .readersAt.center { max-width: 980px; margin: 0 auto; text-align: center; }
  .readersAt .kicker { margin: 0 0 14px; }
  .names {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 6px 0;
    font: 500 clamp(1.05rem, 1.9vw, 1.35rem)/1.4 var(--serif); color: var(--ink);
  }
  .readersAt.center .names { justify-content: center; }
  .names li { white-space: nowrap; }
  /* A thin blue dot between names. */
  .names li:not(:last-child)::after { content: ''; display: inline-block; width: 5px; height: 5px; margin: 0 16px; border-radius: 50%; background: var(--blue); vertical-align: middle; }
  .readersAt .note { margin: 14px 0 0; font: 400 .95rem/1.5 var(--sans); color: var(--muted); }
  @media (max-width: 560px) {
    .names { flex-direction: column; gap: 4px; }
    .names li { white-space: normal; }
    .names li:not(:last-child)::after { display: none; }
  }
</style>
