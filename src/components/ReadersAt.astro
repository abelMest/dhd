---
// "Read by people at…": organisations readers work at, as plain names (not logos, which would suggest
// endorsement). Edited in the console under Who reads the Digest; hidden until it lists at least three.
import type { Copy } from '../lib/copy';
import T from './T.astro';
interface Props { copy: Copy; align?: 'center' | 'start' }
const { copy, align = 'center' } = Astro.props;
const orgs = copy.readersAt.split('\n').map((s) => s.trim()).filter(Boolean);
const note = copy.readersNote.trim();
---
{orgs.length >= 3 && (
  <div class:list={['readersAt', align]}>
    <p class="kicker"><T en="Read by people at" fr="Lu par des personnes de" /></p>
    <ul>{orgs.map((o) => <li>{o}</li>)}</ul>
    {note && <p class="note">{note}</p>}
  </div>
)}

<style>
  .readersAt { max-width: 980px; }
  .readersAt.center { margin: 0 auto; text-align: center; }
  .readersAt .kicker { margin: 0 0 14px; }
  .readersAt ul {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 6px 0;
    font: 500 clamp(1.05rem, 1.9vw, 1.35rem)/1.4 var(--serif); color: var(--ink);
  }
  .readersAt.center ul { justify-content: center; }
  .readersAt li { white-space: nowrap; }
  /* A thin blue dot between names; it never starts a wrapped line. */
  .readersAt li:not(:last-child)::after { content: ''; display: inline-block; width: 5px; height: 5px; margin: 0 16px; border-radius: 50%; background: var(--blue); vertical-align: middle; }
  .readersAt .note { margin: 14px 0 0; font: 400 .95rem/1.5 var(--sans); color: var(--muted); }
  @media (max-width: 560px) {
    .readersAt ul { flex-direction: column; gap: 4px; }
    .readersAt li { white-space: normal; }
    .readersAt li:not(:last-child)::after { display: none; }
  }
</style>
