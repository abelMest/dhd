---
// One opportunity as a card: countdown ring, the facts that decide whether to apply, and quick actions.
// Data attributes feed the filters on /opportunities/ and the "Add to calendar" button.
import type { Opportunity } from '../lib/data';
import { daysBetween, fmtDate, oppState, today, verifyState } from '../lib/data';

interface Props { o: Opportunity; level?: 'h2' | 'h3'; compact?: boolean; featured?: boolean }
const { o, level = 'h3', compact = false } = Astro.props;
const H = level;
const t = today();
const left = o.deadline ? daysBetween(t, o.deadline) : null;
const state = oppState(o, t);
const ver = verifyState(o, t);
const R = 30, C = 2 * Math.PI * R;
// A full ring is 60 or more days left; it empties as the deadline nears.
const frac = left === null ? 1 : Math.max(0.03, Math.min(1, left / 60));
const urgent = left !== null && left <= 14;
const anchor = `opp-${o.id}`;
const search = [o.title, o.org, o.kind, o.eligibility, o.countries.join(' ')].join(' ').toLowerCase();
---
<article
  class:list={['oppCard', { urgent, compact }]}
  id={anchor}
  data-reveal
  data-kind={o.kind}
  data-countries={o.countries.join('|')}
  data-deadline={o.deadline}
  data-verified={o.verifiedAt}
  data-text={search}
>
  <div class="oppTop">
    <div class="tags">
      {Astro.props.featured && <span class="pill featured">Featured</span>}
      <span class="pill brand">{o.kind}</span>
      <span class={`pill ${state.tone}`}>{state.label}</span>
    </div>
    <div class:list={['ring', { warn: urgent }]} aria-hidden="true">
      <svg viewBox="0 0 72 72" width="72" height="72">
        <circle class="track" cx="36" cy="36" r={R} />
        <circle class="val" cx="36" cy="36" r={R} stroke-dasharray={C.toFixed(1)} stroke-dashoffset={(C * (1 - frac)).toFixed(1)} data-ring={(C * (1 - frac)).toFixed(1)} data-c={C.toFixed(1)} />
      </svg>
      <div>{left === null ? <><b>∞</b><span>Rolling</span></> : <><b class="num">{left}</b><span>{left === 1 ? 'day' : 'days'}</span></>}</div>
    </div>
  </div>
  <H class="oppTitle"><a href={o.url} rel="noopener" target="_blank">{o.title}<span class="sr"> (opens the official page)</span></a></H>
  {o.org && <p class="org">{o.org}</p>}
  <dl class="oppFacts">
    <div><dt>Deadline</dt><dd>{o.deadline ? <strong class="num">{fmtDate(o.deadline)}</strong> : 'Rolling, check the source'}{left !== null && <span class="sr">, {left} days left</span>}</dd></div>
    {o.countries.length > 0 && <div><dt>Where</dt><dd>{o.countries.join(', ')}</dd></div>}
    {!compact && o.eligibility && <div class="wide"><dt>Who can apply</dt><dd>{o.eligibility}</dd></div>}
  </dl>
  <div class="oppFoot">
    <span class:list={['checked', { warnText: ver.tone === 'warn' }]}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
      {ver.label}
    </span>
    <div class="actions">
      {o.deadline && !compact && (
        <button class="iconBtn" type="button" data-ics data-title={o.title} data-org={o.org} data-url={o.url} data-date={o.deadline} aria-label={`Add the ${o.title} deadline to your calendar`} title="Add deadline to calendar">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18M12 14v4M10 16h4" /></svg>
        </button>
      )}
      {!compact && (
        <button class="iconBtn" type="button" data-copy-opp={anchor} aria-label={`Copy a link to ${o.title}`} title="Copy link">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1" /><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" /></svg>
        </button>
      )}
      <a class="btn sm" href={o.url} rel="noopener" target="_blank">Details at source <span class="arrow" aria-hidden="true">↗</span></a>
    </div>
  </div>
</article>
