---
// Substack blocks embedding its form, so this opens Substack's subscribe page with the email filled in (as in v6).
import { loadSite } from '../lib/data';
const { id = 'sub', note = true } = Astro.props as { id?: string; note?: boolean };
const { settings, copy } = await loadSite();
const action = settings.substackUrl.replace(/\/+$/, '') + '/subscribe';
---
<form class="subscribe" action={action} method="get" target="_blank">
  <label class="sr" for={id}>Email address</label>
  <input id={id} name="email" type="email" required autocomplete="email" placeholder="you@example.org" />
  <input type="hidden" name="utm_source" value="dhd_hub" />
  <button class="btn" type="submit">Subscribe free</button>
</form>
{note && <p class="subNote">{copy.subSub} Opens Substack to confirm.</p>}
